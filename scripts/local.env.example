# Config local del scraper. Copiar a scripts/local.env (gitignoreado) y completar.
#
# El repo es público y los nombres de bucket incluyen el account id de AWS, así
# que no viven en el código. Sacá los valores con:
#   terraform -chdir=infra output -raw raw_bucket

BIRRAS_RAW_BUCKET=""
AWS_PROFILE="birras-scraper"

# Plataforma que se scrapea localmente (Cloudflare bloquea las IPs de AWS)
BIRRAS_LOCAL_PLATFORM="pedidosya"
